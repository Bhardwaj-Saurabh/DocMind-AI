# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here  # For Claude models

# Model Configuration - Text Extraction (Fast & Cheap)
TEXT_EXTRACTION_MODEL=gpt-4.1-mini  # Cheapest for simple text extraction
TEXT_EXTRACTION_PROVIDER=openai  # openai, anthropic

# Model Configuration - Vision Processing (Multimodal)
VISION_MODEL=gpt-4.1  # For image and visual content
VISION_PROVIDER=openai  # openai, anthropic

# Model Configuration - Complex Analysis (Advanced)
ADVANCED_MODEL=claude-sonnet-4-5  # For complex documents requiring deep analysis
ADVANCED_PROVIDER=anthropic  # openai, anthropic

# Model Configuration - Quality Validation
VALIDATOR_MODEL=gpt-4.1  # For quality checking and validation
VALIDATOR_PROVIDER=openai  # openai, anthropic

# Available Models by Use Case:
# Simple Text: gpt-4o-mini, gpt-3.5-turbo (cheapest)
# Vision: gpt-4o, gpt-4-turbo (best multimodal)
# Advanced: claude-sonnet-4-5, gpt-5 (best reasoning)
# Quality Check: gpt-4.1, claude-sonnet-4-5 (high accuracy)

# Adaptive Routing Configuration
ENABLE_ADAPTIVE_ROUTING=true  # Route to best model based on content
AUTO_MODEL_SELECTION=true  # Automatically select model based on complexity

# Cost Limits (optional - for tracking and limiting costs)
MAX_COST_PER_DOCUMENT=1.00  # Maximum cost in USD per document
MAX_COST_PER_PAGE=0.10  # Maximum cost per page
ENABLE_COST_TRACKING=true
COST_ALERT_THRESHOLD=0.50  # Alert when cost exceeds this threshold

# Processing Configuration
MAX_PARALLEL_PAGES=5  # Number of pages to process in parallel
ENABLE_VISION_FALLBACK=true  # Enable vision API fallback for failed extractions
ENABLE_QUALITY_VALIDATION=true  # Enable quality validation step

# Model Fallback Chain (comma-separated, in order of preference)
TEXT_FALLBACK_MODELS=gpt-4o-mini,gpt-4o,claude-sonnet-4-5
VISION_FALLBACK_MODELS=gpt-4o,gpt-4-turbo,claude-sonnet-4-5

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=docmind.log
ENABLE_DETAILED_LOGGING=true

# Cache Configuration (optional)
ENABLE_CACHE=true
CACHE_DIR=.cache
CACHE_EXPIRY_HOURS=24

# Performance Configuration
BATCH_SIZE=10  # Number of items to process in a batch
REQUEST_TIMEOUT=30  # Timeout for API requests in seconds
MAX_RETRIES=3  # Maximum number of retries for failed requests
